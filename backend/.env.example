# Backend VM (web1-paris) — copier vers /etc/supfile/supfile.env

DEPLOYMENT_MODE=hybrid
APP_ENV=production
DEBUG=false
PRIMARY_DC=PARIS
FAILOVER_DC=NEW_YORK
ACTIVE_ACTIVE=true

SECRET_KEY=change-me-minimum-32-characters-long
JWT_SECRET_KEY=change-me-jwt-secret-32-chars

HOST=0.0.0.0
PORT=8080

# ProxySQL → Galera
DATABASE_URL=mysql+pymysql://supfile_app:MOT_DE_PASSE@10.10.1.32:6033/supfile

# Stockage GlusterFS (monter avant démarrage)
STORAGE_BACKEND=local
UPLOAD_PATH=/mnt/gluster/supfile
UPLOAD_REGION=paris-dc
CHUNK_UPLOAD_ENABLED=true
CHUNK_SIZE_MB=8
CHUNK_TMP_PATH=/tmp/supfile-chunks

# URL publique (Tailscale Funnel ou HAProxy)
BACKEND_PUBLIC_URL=https://web1-paris.votre-tailnet.ts.net
OAUTH_CALLBACK_BASE_URL=https://web1-paris.votre-tailnet.ts.net

# Frontend Vercel
CORS_ORIGINS=https://votre-app.vercel.app
OAUTH_REDIRECT_BASE_URL=https://votre-app.vercel.app
OAUTH_ALLOWED_REDIRECT_URIS=https://supfile-webapp.vercel.app/auth/callback,https://web1-paris.tail69cc44.ts.net/auth/callback,https://web1-ny.tail69cc44.ts.net/auth/callback

# Security stack
WAZUH=true
SURICATA=true
FAIL2BAN=true
UFW=true

# Ingress compatibility
TRUST_PROXY_HEADERS=true
HAPROXY_COMPAT=true
TAILSCALE_FUNNEL_COMPAT=true

# OAuth (optionnel)
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
