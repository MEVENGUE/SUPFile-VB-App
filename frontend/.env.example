# Frontend Vercel — copier dans les variables d'environnement du projet Vercel

# Backend via Tailscale Funnel ou HAProxy (obligatoire en production)
VITE_API_URL=https://web1-paris.votre-tailnet.ts.net/api/v1

# WebSocket (optionnel, dérivé de VITE_API_URL si absent)
VITE_WS_URL=wss://web1-paris.votre-tailnet.ts.net/api/v1/ws

# URL publique backend (OAuth — même host que Funnel/HAProxy)
VITE_BACKEND_PUBLIC_URL=https://web1-paris.votre-tailnet.ts.net

VITE_APP_NAME=SUPFile
